# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://afa:CHANGE_ME@127.0.0.1:5432/afa?schema=public"

# ─── Auth ───────────────────────────────────────────────────────────────────
# 32+ characters. Generate with: openssl rand -base64 48
AUTH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS"
SESSION_TTL_HOURS=72

# ─── Chain ──────────────────────────────────────────────────────────────────
# Nothing in the code is tied to a particular chain: the name, the native coin
# and the explorer are all read from here. Moving chains is configuration, plus
# a redeploy of the factory — deposit addresses are derived from it, so they
# belong to the chain it was deployed on and to no other.
#
#   11155111  Ethereum Sepolia   ← the current launch target
#         56  BNB Smart Chain
#          1  Ethereum
#      31337  a local node (npm run chain)
CHAIN_ID=11155111
# Sepolia is served fine by a public node. On BSC mainnet a keyed provider is
# required — public endpoints there throttle or refuse eth_getLogs.
#   Sepolia    https://ethereum-sepolia-rpc.publicnode.com
#   Alchemy    https://eth-sepolia.g.alchemy.com/v2/<key>
CHAIN_RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"
# Optional. When set, `npm run watch:chain` subscribes to transfers in real time
# instead of polling. Worth it on a chain with sub-second blocks; on Sepolia's
# twelve-second blocks polling keeps up on its own.
CHAIN_WSS_URL=""
CHAIN_EXPLORER_URL="https://sepolia.etherscan.io"

# The settled token on the chain above. Sepolia has no USDT, so a stand-in is
# deployed with `npm run contracts:token` and its address goes here.
#   BSC mainnet: 0x55d398326f99059fF775485246999027B3197955 (18 decimals)
USDT_CONTRACT_ADDRESS=""
USDT_DECIMALS=6

# How a deposit is judged irreversible.
#   finalized      — ask the node for its finalised head. Both BSC and every
#                    post-merge Ethereum network serve this, and it is a far
#                    better signal than a confirmation count.
#   confirmations  — count blocks, for nodes without the finalized tag
CHAIN_FINALITY="finalized"
CHAIN_MIN_CONFIRMATIONS=15

# Blocks per getLogs request. Providers cap this per plan, and the cap differs:
# Alchemy's free tier allows 10, QuickNode's 5, the Sepolia public node about a
# thousand. A rejected window is halved and retried, so an over-large value
# costs requests rather than failing.
CHAIN_SCAN_BATCH=500
# Upper bound on getLogs requests per sweep, so one pass stays bounded.
CHAIN_SCAN_MAX_REQUESTS=40
# Bearer token the /api/chain/watch endpoint requires. openssl rand -hex 24
CHAIN_WATCHER_TOKEN=""

# What the browser is allowed to know. The RPC URL is deliberately not here —
# on a keyed provider it carries the key, and a wallet brings its own node.
# Inlined at build time, so pointing a deployment at another chain means a
# rebuild, which is correct: the addresses baked in belong to that chain.
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_CHAIN_EXPLORER_URL="https://sepolia.etherscan.io"

# ─── Email (login codes) ────────────────────────────────────────────────────
# console — prints to the server log, development only
# smtp    — any mail server, set SMTP_*
# resend  — Resend HTTP API, set RESEND_API_KEY
EMAIL_PROVIDER="console"
# Must be a domain verified with the provider, or delivery is refused.
EMAIL_FROM="AFA <no-reply@your-verified-domain>"

SMTP_HOST=""
SMTP_PORT=465
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASSWORD=""

RESEND_API_KEY=""

OTP_TTL_MINUTES=3
OTP_MAX_ATTEMPTS=5

# ─── Seed (first boot only) ─────────────────────────────────────────────────
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="ادمین سیستم"
SEED_BANK_EMAIL="bank@example.com"
SEED_BANK_PASSWORD=""
SEED_BANK_NAME="مدیر عملیات ارزی"
# Bank wallets on the configured chain. At least a RECEIVE wallet is required
# before any invoice can be approved.
SEED_BANK_RECEIVE_WALLET=""
SEED_BANK_SEND_WALLET=""


# Settlement factory — deploy with `npm run contracts:deploy`.
GATEWAY_FACTORY_ADDRESS=

# Settlement contract — where each share of a payment goes. All three must
# differ. Changing them means redeploying the factory; addresses already quoted
# keep the terms they were derived from.
GATEWAY_WALLET=
FREEZONE_WALLET=
BANK_TREASURY_WALLET=
GATEWAY_FEE_PERCENT=2
FREEZONE_SHARE_PERCENT=50
GATEWAY_FEE_MIN=1
GATEWAY_FEE_MAX=500
