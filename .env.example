# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://afa:CHANGE_ME@127.0.0.1:5432/afa?schema=public"

# ─── Auth ───────────────────────────────────────────────────────────────────
# 32+ characters. Generate with: openssl rand -base64 48
AUTH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS"
SESSION_TTL_HOURS=72

# ─── Chain (BSC) ────────────────────────────────────────────────────────────
# Mainnet: 56 · Testnet: 97
CHAIN_ID=56
# A keyed provider is required: public endpoints throttle or refuse eth_getLogs.
#   Alchemy    https://bnb-mainnet.g.alchemy.com/v2/<key>
#   QuickNode  https://<endpoint>.bsc.quiknode.pro/<token>/
CHAIN_RPC_URL="https://bnb-mainnet.g.alchemy.com/v2/<key>"
# Optional. When set, `npm run watch:chain` subscribes to transfers in real time
# instead of polling — the only mode that keeps pace with BSC's ~0.45s blocks.
CHAIN_WSS_URL="wss://bnb-mainnet.g.alchemy.com/v2/<key>"
CHAIN_EXPLORER_URL="https://bscscan.com"
# BEP-20 USDT on the chain above.
#   mainnet: 0x55d398326f99059fF775485246999027B3197955
#   testnet: 0x337610d27c682e347c9cd60bd4b3b107c9d34ddd
USDT_CONTRACT_ADDRESS="0x55d398326f99059fF775485246999027B3197955"
USDT_DECIMALS=18

# How a deposit is judged irreversible.
#   finalized      — ask the node for its finalised head (correct on BSC)
#   confirmations  — count blocks, for nodes without the finalized tag
CHAIN_FINALITY="finalized"
CHAIN_MIN_CONFIRMATIONS=15

# Blocks per getLogs request. Providers cap this per plan — Alchemy's free tier
# allows 10, QuickNode's allows 5. A rejected window is halved and retried, so
# an over-large value costs requests rather than failing.
CHAIN_SCAN_BATCH=10
# Upper bound on getLogs requests per sweep, so one pass stays bounded.
CHAIN_SCAN_MAX_REQUESTS=40
# Bearer token the /api/chain/watch endpoint requires. openssl rand -hex 24
CHAIN_WATCHER_TOKEN=""

# ─── Email (login codes) ────────────────────────────────────────────────────
# console — prints to the server log, development only
# smtp    — any mail server, set SMTP_*
# resend  — Resend HTTP API, set RESEND_API_KEY
EMAIL_PROVIDER="console"
# Must be a domain verified with the provider, or delivery is refused.
EMAIL_FROM="AFA <no-reply@your-verified-domain>"

SMTP_HOST=""
SMTP_PORT=465
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASSWORD=""

RESEND_API_KEY=""

OTP_TTL_MINUTES=3
OTP_MAX_ATTEMPTS=5

# ─── Seed (first boot only) ─────────────────────────────────────────────────
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="ادمین سیستم"
SEED_BANK_EMAIL="bank@example.com"
SEED_BANK_PASSWORD=""
SEED_BANK_NAME="مدیر عملیات ارزی"
# Bank wallets on the configured chain. At least a RECEIVE wallet is required
# before any invoice can be approved.
SEED_BANK_RECEIVE_WALLET=""
SEED_BANK_SEND_WALLET=""

# Deposit addresses are derived per payment from this extended PUBLIC key.
# Generate a pair with `npm run gen:xpub`; the mnemonic it prints belongs in the
# bank operator wallet and must never be stored here.
GATEWAY_XPUB=
GATEWAY_DERIVATION_PATH="m/44'/60'/0'/0"
