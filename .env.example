# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://afa:CHANGE_ME@127.0.0.1:5432/afa?schema=public"

# ─── Auth ───────────────────────────────────────────────────────────────────
# 32+ characters. Generate with: openssl rand -base64 48
AUTH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS"
SESSION_TTL_HOURS=72

# ─── Chain (BSC) ────────────────────────────────────────────────────────────
# Testnet: 97 · Mainnet: 56
CHAIN_ID=97
CHAIN_RPC_URL="https://bsc-testnet.drpc.org"
CHAIN_EXPLORER_URL="https://testnet.bscscan.com"
# BEP-20 USDT on the chain above.
#   testnet: 0x337610d27c682e347c9cd60bd4b3b107c9d34ddd
#   mainnet: 0x55d398326f99059fF775485246999027B3197955
USDT_CONTRACT_ADDRESS="0x337610d27c682e347c9cd60bd4b3b107c9d34ddd"
USDT_DECIMALS=18
CHAIN_MIN_CONFIRMATIONS=15
CHAIN_SCAN_BATCH=500
# Bearer token the deposit watcher endpoint requires. Generate with: openssl rand -hex 24
CHAIN_WATCHER_TOKEN=""

# ─── SMS (OTP) ──────────────────────────────────────────────────────────────
# console: prints the code to the server log — development only.
SMS_PROVIDER="console"
SMS_API_KEY=""
SMS_SENDER=""
SMS_TEMPLATE=""

OTP_TTL_MINUTES=3
OTP_MAX_ATTEMPTS=5

# ─── Seed (first boot only) ─────────────────────────────────────────────────
SEED_ADMIN_EMAIL="admin@afa.local"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="ادمین سیستم"
SEED_BANK_EMAIL="bank@afa.local"
SEED_BANK_PASSWORD=""
SEED_BANK_NAME="مدیر عملیات ارزی"
# Bank wallets on the configured chain. At least a RECEIVE wallet is required
# before any invoice can be approved.
SEED_BANK_RECEIVE_WALLET=""
SEED_BANK_SEND_WALLET=""
