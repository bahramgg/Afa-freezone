// AFA — currency payment gateway for the Free Zone Organization.
//
// Money moves through three flows (receive / send / settle), each a state
// machine advanced by a different actor. Every transition is appended to
// StatusEvent so the whole chain of custody stays auditable.

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────── Identity ───────────────────────────

enum Role {
  IRANIAN
  FOREIGN
  ADMIN
  BANK
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String @id @default(cuid())
  /** Human-facing identifier shown in the UI: IR-001, FOR-042, ... */
  uid       String @unique
  role      Role

  fullName  String
  email     String? @unique
  /** Normalised to +989xxxxxxxxx before storage. */
  phone     String? @unique
  /** Argon2id hash. Null for Iranian users, who authenticate by OTP. */
  passwordHash String?

  // Iranian merchants
  nationalId String? @unique
  freezoneId String?

  // Foreign merchants
  passportNo String?
  country    String?

  address     String?
  avatarColor String  @default("oklch(0.7 0.16 280)")

  kyc             KycStatus @default(PENDING)
  kycRejectReason String?
  kycReviewedAt   DateTime?
  kycReviewedById String?
  kycReviewedBy   User?     @relation("KycReviewer", fields: [kycReviewedById], references: [id], onDelete: SetNull)
  kycReviewed     User[]    @relation("KycReviewer")

  disabledAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  wallets          Wallet[]
  walletChallenges WalletChallenge[]
  sessions         Session[]
  otpCodes      OtpCode[]
  notifications Notification[]
  statusEvents  StatusEvent[]

  ledgerEntries      LedgerEntry[]
  refundsRequested   Refund[]      @relation("RefundRequester")
  invoices           Invoice[]     @relation("InvoiceOwner")
  sendRequests       SendRequest[] @relation("SendOwner")
  sendCounterparties SendRequest[] @relation("SendCounterparty")
  settlements        Settlement[]  @relation("SettlementOwner")

  @@index([role, kyc])
}

model Session {
  id        String   @id @default(cuid())
  /** SHA-256 of the opaque token; the raw token only ever lives in the cookie. */
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

enum OtpPurpose {
  LOGIN
}

model OtpCode {
  id    String @id @default(cuid())
  /** Lowercased email the code was sent to. */
  email String
  /** Argon2id hash of the code — a leaked table must not hand over live codes. */
  codeHash  String
  purpose   OtpPurpose @default(LOGIN)
  attempts  Int        @default(0)
  consumedAt DateTime?
  expiresAt DateTime
  createdAt DateTime   @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, createdAt])
}

// ─────────────────────────── Wallets ───────────────────────────

enum WalletOwnerKind {
  USER
  BANK
}

enum BankWalletKind {
  SEND
  RECEIVE
  SHARED
}

model Wallet {
  id        String          @id @default(cuid())
  /** Lowercased 0x-prefixed BSC address. */
  address   String
  label     String
  ownerKind WalletOwnerKind @default(USER)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /** Only meaningful for bank-owned wallets. */
  bankKind BankWalletKind?
  active   Boolean         @default(true)

  /** True only once a signature recovered to this address. Never set by hand. */
  verified   Boolean   @default(false)
  verifiedAt DateTime?
  /** The signature that proved control, kept so the proof stays auditable. */
  proofSignature String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([address, userId])
  @@index([ownerKind, active])
}

/**
 * A nonce the user must sign with their wallet to prove they control it.
 *
 * The system holds no keys, so ownership can only be established by asking the
 * holder to sign something the system chose. The nonce makes a captured
 * signature useless: it is single-use, short-lived, and bound to one address
 * and one account.
 */
model WalletChallenge {
  id      String @id @default(cuid())
  address String
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  nonce      String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, address, createdAt])
}

// ─────────────────────────── Shared money types ───────────────────────────

enum Currency {
  USDT
  BNB
}

enum Actor {
  USER
  COUNTERPARTY
  ADMIN
  BANK
  SYSTEM
}

/// Append-only audit trail. One row per state transition, on any flow.
model StatusEvent {
  id        String   @id @default(cuid())
  /** "invoice" | "send" | "settlement" */
  subject   String
  subjectId String
  fromStatus String?
  toStatus   String
  actor      Actor
  note       String?

  actorUserId String?
  actorUser   User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([subject, subjectId, createdAt])
}

// ─────────────────────────── Flow 1: receive ───────────────────────────

enum InvoiceStatus {
  PENDING
  APPROVED
  PAYMENT_PENDING
  PAID
  EXPIRED
  REJECTED
}

model Invoice {
  id     String @id @default(cuid())
  /** INV-1042 */
  ref    String @unique
  /** TRX-1042 — the identifier both parties quote to each other. */
  trxRef String @unique

  ownerId String
  owner   User   @relation("InvoiceOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  /** Stored in the token's smallest unit as a decimal to avoid float drift. */
  amount   Decimal  @db.Decimal(38, 18)
  currency Currency

  description String
  goodsTitle  String
  senderName  String

  status InvoiceStatus @default(PENDING)

  /**
   * Gateway address the foreign buyer must pay into — derived for this invoice
   * alone, so whatever arrives there belongs to it and nothing else.
   */
  paymentAddress String?
  depositAddress DepositAddress?
  /** What actually arrived, which may differ from `amount`. */
  receivedAmount Decimal? @db.Decimal(38, 18)
  /** Merchant wallet that receives the settled funds. */
  walletAddress  String?

  feeAmount Decimal? @db.Decimal(38, 18)
  netAmount Decimal? @db.Decimal(38, 18)

  rejectReason String?
  expiresAt    DateTime?
  paidAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chainTxId String?      @unique
  chainTx   ChainTx?     @relation(fields: [chainTxId], references: [id], onDelete: SetNull)

  /** The payout settlement raised once this invoice was paid. */
  settlement Settlement? @relation("InvoiceSettlement")

  documents TradeDocument[]
  refunds   Refund[]

  @@index([ownerId, status])
  @@index([status, createdAt])
}

/**
 * The commercial paper a currency transfer rests on.
 *
 * A bank supplying foreign currency to an importer, or buying it from an
 * exporter, cannot do so against a free-text description of the goods — the
 * transfer has to be tied to a document the customs authority and the free zone
 * can both point at. The number and date are recorded here; the paper itself
 * stays with the parties.
 */
enum TradeDocumentKind {
  /** پیش‌فاکتور */
  PROFORMA
  /** ثبت سفارش */
  ORDER_REGISTRATION
  /** کوتاژ / اظهارنامه گمرکی */
  CUSTOMS_DECLARATION
  /** قرارداد */
  CONTRACT
}

model TradeDocument {
  id     String            @id @default(cuid())
  kind   TradeDocumentKind
  number String
  issuedAt DateTime?
  issuer   String?
  note     String?

  invoiceId String?
  invoice   Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sendId    String?
  send      SendRequest? @relation(fields: [sendId], references: [id], onDelete: Cascade)
  settlementId String?
  settlement   Settlement? @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@index([sendId])
  @@index([settlementId])
}

// ─────────────────────────── Flow 2: send ───────────────────────────

enum SendStatus {
  AWAITING_COUNTERPARTY
  AWAITING_ADMIN
  AWAITING_BANK_REVIEW
  BANK_RATE_LOCKED
  RIAL_RECEIVED
  CRYPTO_SENT
  PAID
  REJECTED
}

model SendRequest {
  id     String @id @default(cuid())
  ref    String @unique
  trxRef String @unique

  ownerId String
  owner   User   @relation("SendOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  counterpartyId String?
  counterparty   User?   @relation("SendCounterparty", fields: [counterpartyId], references: [id], onDelete: SetNull)
  /**
   * Free-text identifier for the counterparty. An importer usually has their
   * supplier's details from the proforma and the supplier has no account here,
   * so this is a name or reference rather than a uid in the common case.
   */
  counterpartyUid String
  /** Supplier's name as it appears on the commercial documents. */
  counterpartyName  String?
  /** Optional, only so the supplier can be told the transfer is on its way. */
  counterpartyEmail String?
  /**
   * True when the destination wallet was confirmed by the counterparty rather
   * than only typed by the importer. Recorded, never required: a supplier
   * without an account cannot be made to sign in.
   */
  recipientConfirmed Boolean @default(false)

  amount      Decimal  @db.Decimal(38, 18)
  currency    Currency
  description String?

  status SendStatus @default(AWAITING_COUNTERPARTY)

  /** Rial per token. Locked by the bank; not editable afterwards. */
  exchangeRate Decimal? @db.Decimal(24, 4)
  rateLocked   Boolean  @default(false)
  rateLockedAt DateTime?
  rialAmount   Decimal? @db.Decimal(24, 2)

  /** Gateway fee, in the token. Charged once per journey. */
  feeAmount Decimal? @db.Decimal(38, 18)
  /**
   * The token amount the rial leg is computed from — always the merchant's side
   * of the ledger. Sending, they pay for the amount plus the fee; receiving,
   * they are credited for the amount less the fee.
   */
  netAmount Decimal? @db.Decimal(38, 18)

  /** The bank's exchange margin on this request, in rial. */
  bankSpreadRial Decimal? @db.Decimal(24, 2)

  /** Bank account the merchant must deposit the rial into. Named by the bank. */
  depositAccount String?
  rialReceiptNo  String?
  rialDepositAt  DateTime?

  recipientWalletAddress String?
  bankWalletAddress      String?

  rejectedBy   Actor?
  rejectReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chainTxId String?  @unique
  chainTx   ChainTx? @relation(fields: [chainTxId], references: [id], onDelete: SetNull)

  documents TradeDocument[]

  @@index([ownerId, status])
  @@index([status, createdAt])
}

// ─────────────────────────── Flow 3: settlement ───────────────────────────

enum SettlementStatus {
  AWAITING_ADMIN
  AWAITING_BANK
  BANK_RATE_LOCKED
  CRYPTO_RECEIVED
  CRYPTO_CONFIRMED
  SETTLED
  REJECTED
}

model Settlement {
  id     String @id @default(cuid())
  ref    String @unique
  trxRef String @unique

  ownerId String
  owner   User   @relation("SettlementOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  goodsTitle  String
  description String

  amount   Decimal  @db.Decimal(38, 18)
  currency Currency

  /**
   * Merchant wallet the crypto is sent from. Null for a settlement raised from
   * a paid invoice, where the crypto is already sitting in the bank's wallet.
   */
  walletAddress String?
  /** Rial account the proceeds are paid into. Named by the merchant. */
  payoutAccount String?

  status SettlementStatus @default(AWAITING_ADMIN)

  exchangeRate Decimal?  @db.Decimal(24, 4)
  rateLocked   Boolean   @default(false)
  rateLockedAt DateTime?
  rialAmount   Decimal?  @db.Decimal(24, 2)

  /** Gateway fee, in the token. Zero when the source invoice already paid it. */
  feeAmount Decimal? @db.Decimal(38, 18)
  /** The token amount the rial leg is computed from: amount less the fee. */
  netAmount Decimal? @db.Decimal(38, 18)
  /** The bank's exchange margin on this settlement, in rial. */
  bankSpreadRial Decimal? @db.Decimal(24, 2)

  /**
   * Set when this settlement was raised automatically from a paid invoice. The
   * crypto is then already held by the bank, so the merchant sends nothing and
   * the gateway fee was already taken on the invoice.
   */
  sourceInvoiceId String?  @unique
  sourceInvoice   Invoice? @relation("InvoiceSettlement", fields: [sourceInvoiceId], references: [id], onDelete: SetNull)

  bankWalletAddress String?
  bankResponseAt    DateTime?
  bankResponseNote  String?

  rialReceiptNo String?
  rialDepositAt DateTime?
  settledAt     DateTime?

  rejectedBy   Actor?
  rejectReason String?

  documents TradeDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /** The merchant's payout transaction, verified on chain. */
  chainTxId String?  @unique
  chainTx   ChainTx? @relation(fields: [chainTxId], references: [id], onDelete: SetNull)

  @@index([ownerId, status])
  @@index([status, createdAt])
}

/**
 * Money going back the way it came.
 *
 * A trade can fall through after the buyer has paid, and until now there was no
 * way to return anything: the only paths money could take were forwards. The
 * destination is never typed by anyone — it is the address the payment arrived
 * from, read off the chain — so a refund cannot be misdirected by a slip.
 */
enum RefundStatus {
  REQUESTED
  APPROVED
  SENT
  REJECTED
}

model Refund {
  id  String @id @default(cuid())
  ref String @unique

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  amount   Decimal  @db.Decimal(38, 18)
  currency Currency
  /** Read from the deposit that funded the invoice, never supplied by a caller. */
  toAddress String

  status RefundStatus @default(REQUESTED)
  reason String

  requestedById String?
  requestedBy   User?   @relation("RefundRequester", fields: [requestedById], references: [id], onDelete: SetNull)

  /** The operator's transfer, verified on chain before the refund is closed. */
  txHash String?
  sentAt DateTime?

  rejectReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([invoiceId])
}

// ─────────────────────────── Ledger ───────────────────────────

/**
 * Where value sits, or who has a claim on it.
 *
 * The bank's wallet holds one pile of tokens with several owners: money still
 * owed to merchants, fee the gateway has earned, and the bank's own. Without
 * naming those claims the balance is a single number nobody can reconcile.
 */
enum LedgerAccount {
  /** Arrived at a per-invoice deposit address, not yet swept. */
  DEPOSIT_HELD
  /** Swept into the bank's treasury wallet. */
  BANK_HELD
  /** Owed to merchants and not yet paid out in rial. */
  MERCHANT_PAYABLE
  /** The gateway's share of the fee. */
  GATEWAY_SHARE
  /** The Free Zone Organization's share of the same fee. */
  FREEZONE_SHARE
  /** The bank's exchange margin, in rial. */
  BANK_SPREAD
  /** Returned to a buyer after a trade fell through. */
  REFUNDED
  /** The gateway's fee, actually received on chain. */
  GATEWAY_PAID
  /** The organization's share, actually received on chain. */
  FREEZONE_PAID
}

enum LedgerUnit {
  USDT
  BNB
  IRR
}

/**
 * Append-only record of every movement of value.
 *
 * Balances are the sum of the entries for an account, never a stored total, so
 * a wrong figure can always be traced to the entry that caused it rather than
 * being silently overwritten.
 */
model LedgerEntry {
  id      String        @id @default(cuid())
  account LedgerAccount
  /** Positive adds to the account, negative takes from it. */
  amount  Decimal       @db.Decimal(38, 18)
  unit    LedgerUnit

  /** What happened: INVOICE_PAID, DEPOSIT_SWEPT, SETTLEMENT_SETTLED, ... */
  kind String

  /** "invoice" | "send" | "settlement" | "deposit" */
  subject    String?
  subjectId  String?
  /** The human-facing reference, so a report reads without a join. */
  subjectRef String?

  /** Whose claim this is, where the account is per-merchant. */
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  note      String?
  createdAt DateTime @default(now())

  @@index([account, createdAt])
  @@index([subject, subjectId])
  @@index([userId, account])
}

// ─────────────────────────── Chain ───────────────────────────

enum ChainTxStatus {
  SEEN
  CONFIRMING
  CONFIRMED
  FAILED
}

enum ChainTxDirection {
  IN
  OUT
}

/// A transaction observed on chain. Written only by the watcher and the
/// verification endpoint — never trusted straight from a client.
model ChainTx {
  id     String @id @default(cuid())
  hash   String @unique
  chainId Int

  direction ChainTxDirection
  status    ChainTxStatus    @default(SEEN)

  fromAddress String
  toAddress   String

  currency Currency
  /** Human-scale amount, decoded using the token's decimals. */
  amount   Decimal @db.Decimal(38, 18)
  /** Raw on-chain integer value, kept for exact re-verification. */
  rawValue String

  blockNumber   BigInt?
  confirmations Int      @default(0)
  gasFee        Decimal? @db.Decimal(38, 18)

  seenAt      DateTime  @default(now())
  confirmedAt DateTime?

  /** Set once the deposit is matched to an invoice or settlement. */
  matchedAt DateTime?

  invoice     Invoice?
  sendRequest SendRequest?
  settlement  Settlement?

  @@index([toAddress, status])
  @@index([status, blockNumber])
}

/**
 * A deposit address derived for one payment.
 *
 * Held so the watcher knows which addresses to scan, and so the operator can
 * see what is sitting where before sweeping. The system never holds the key to
 * any of these — see lib/server/chain/hd.ts.
 */
model DepositAddress {
  id String @id @default(cuid())
  /** Sequence number, kept only so the operator has something short to quote. */
  index   Int    @unique
  address String @unique

  /**
   * The split this address is bound to, as the contract received it.
   *
   * Releasing needs exactly these terms — the address is their hash — so they
   * are kept beside it rather than re-read from the factory, whose current
   * terms will have moved on by then.
   */
  terms Json?

  invoiceId String?  @unique
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  /** Everything seen at this address so far, summed across deposits. */
  receivedAmount Decimal @db.Decimal(38, 18) @default(0)

  /** Set once the contract split the balance three ways. */
  sweptAt     DateTime?
  sweepTxHash String?
  /** What the contract actually paid out, read back from its own event. */
  gatewayAmount  Decimal? @db.Decimal(38, 18)
  freezoneAmount Decimal? @db.Decimal(38, 18)
  bankAmount     Decimal? @db.Decimal(38, 18)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sweptAt])
}

/// Bookmark for the deposit watcher, so a restart resumes where it left off.
model ChainCursor {
  chainId         Int    @id
  lastScannedBlock BigInt
  updatedAt       DateTime @updatedAt
}

// ─────────────────────────── Notifications & settings ───────────────────────────

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind  String
  title String
  body  String
  href  String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

/// Single-row table holding the operational parameters the admin panel edits.
model Settings {
  id Int @id @default(1)

  feeBasePercent Decimal @db.Decimal(6, 3) @default(2)
  feeMin         Decimal @db.Decimal(38, 18) @default(1)
  feeMax         Decimal @db.Decimal(38, 18) @default(500)

  invoiceValidityMinutes Int     @default(30)
  invoiceMinAmount       Decimal @db.Decimal(38, 18) @default(10)
  invoiceMaxAmount       Decimal @db.Decimal(38, 18) @default(100000)

  usdtRate Decimal @db.Decimal(24, 4) @default(66800)
  bnbRate  Decimal @db.Decimal(24, 4) @default(222000)

  dailySendLimit       Decimal @db.Decimal(38, 18) @default(50000)
  dailySettlementLimit Decimal @db.Decimal(38, 18) @default(50000)
  minTxAmount          Decimal @db.Decimal(38, 18) @default(10)

  /** Rate a bank-locked exchange rate may deviate from the reference, percent. */
  rateTolerancePercent Decimal @db.Decimal(6, 3) @default(10)
  /** The Free Zone Organization's cut of the gateway fee, percent of the fee. */
  freezoneSharePercent Decimal @db.Decimal(6, 3) @default(50)

  updatedAt DateTime @updatedAt
}
